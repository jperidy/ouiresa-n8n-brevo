# Copie ce fichier en ".env" puis remplis les valeurs.

# Identifiants pour proteger l'editeur n8n (http://localhost:5678)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Genere avec: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Hote/port d'acces local
N8N_HOST=localhost
N8N_PORT=5678

GENERIC_TIMEZONE=Europe/Paris

# Base Postgres (backend de n8n)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
